# Configuracoes do container do banco de dados
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=rabisco

#Configurações internas do backend
JWT_SECRET="unsecure_secret"
DATABASE_URL="postgres://root:root@localhost:5432/rabisco?schema=public"

#Configurações de seed do usuário
USER_NAME="Exemplo de nome"
USER_EMAIL="example@mail.com"
USER_PASSWORD="pass" # A senha deve ser maior ou igual a 6 caracteres
