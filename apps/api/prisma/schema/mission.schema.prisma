model DailyMission {
  id            String   @id @default(uuid()) @db.Uuid
  description   String
  points        Int      @db.Integer
  availableDate DateTime @default(now()) @map("available_date") @db.Timestamptz()

  users UserMission[]

  @@map("daily_missions")
}

model UserMission {
  userId         String    @map("user_id") @db.Uuid
  missionId      String    @map("mission_id") @db.Uuid
  completed      Boolean   @default(false)
  completionDate DateTime? @map("completion_date") @db.Timestamptz()

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mission DailyMission @relation(fields: [missionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, missionId])
  @@map("users_missions")
}
