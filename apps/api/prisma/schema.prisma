generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  avatarPath String?  @map("avatar_path")
  email      String   @unique
  password   String
  createdAt  DateTime @default(now()) @map("created_at")

  refreshTokens      RefreshToken[]
  forgotPasswordCode ForgotPasswordCode?
  texts              Text[]
  categories         Category[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  issuesAt  DateTime @default(now()) @map("issues_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model ForgotPasswordCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  code      String
  issuesAt  DateTime @default(now()) @map("issues_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("forgot_password_codes")
}

enum TextType {
  DIARY
  DAY_PROMPT
  FREE

  @@map("text_type")
}

model Text {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      TextType @default(FREE)
  title     String
  content   String
  wordCount Int      @default(0) @map("word_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  categories TextCategory[]
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("texts")
}

model Category {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  name   String

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  texts TextCategory[]

  @@map("categories")
}

model TextCategory {
  categoryId String @map("category_id") @db.Uuid
  textId     String @map("text_id") @db.Uuid

  text     Text     @relation(fields: [textId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, textId])
  @@map("texts_categories")
}
